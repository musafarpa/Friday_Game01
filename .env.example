# ------------------------------------------------------------------------------
# FRIDAY FUN GAME 2026 - ENVIRONMENT CONFIGURATION
# ------------------------------------------------------------------------------

# ---- Browser (Vite) variables - PUBLIC. Never put a service-role / secret key here. ----
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) or the legacy "anon" JWT. NOT the service_role / sb_secret_ key.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Optional: force the host used in invitation / challenge links (recommended in production),
# e.g. https://friday-fun-2026.vercel.app  - otherwise the current browser origin is used.
VITE_PUBLIC_BASE_URL=

# ---- Server-only (Vercel function /api/generate-question) - set in the Vercel dashboard, NOT in the browser ----
# At least one AI key is optional: without it, the curated question bank is used for the built-in topics.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
